ggplot(data = data1, aes(x = Disease.activity.since.last.return, fill = Gender)) +
geom_bar(width = 0.4) +
geom_text(stat = "count", aes(label = ..count..), position = position_stack(vjust = 0.5)) + # nolint
ggtitle("Gender distrubution across the Disease activity") +
xlab("Disease activity") +
ylab("Frequency") +
