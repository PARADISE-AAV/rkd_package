\item AND SVV (IC) != IgA, cryo
\item AND Secondary vasculitis != Yes
\item AND 'Medium vessel' != 1 or 2
\item AND 'large vessel' != 1 or 2
\item AND 'variable vessel' != 1 or 2
}
